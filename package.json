{
  "name": "project-tx-ind",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "turbo run dev",
    "check": "turbo run typecheck lint test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "prettier": "@repo/config/prettier",
  "devDependencies": {
    "@repo/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
