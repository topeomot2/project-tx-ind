{
  "apps": [
    {
      "name": "api",
      "path": "apps/api",
      "kind": "backend",
      "language": "ts",
      "services": ["postgres", "mailpit"]
    },
    {
      "name": "web",
      "path": "apps/web",
      "kind": "frontend",
      "language": "ts",
      "services": []
    }
  ],
  "services": [
    {
      "name": "postgres",
      "compose": "compose.yaml",
      "env": ["DATABASE_URL"]
    },
    {
      "name": "mailpit",
      "compose": "compose.yaml",
      "env": ["SMTP_URL", "MAILPIT_URL"]
    }
  ],
  "locked": {
    "hard": [
      "specs/product/**",
      "packages/contracts/**",
      "tests/e2e/**",
      "AGENTS.md",
      "docs/**",
      ".agents/**",
      ".github/**",
      "factory.json",
      "LICENSE",
      "packages/checks/**",
      "packages/config/**",
      "package.json",
      "pnpm-workspace.yaml",
      "turbo.json",
      "**/tsconfig.json",
      "**/eslint.config.js",
      "**/vitest*.config.ts",
      "**/stryker.config.js",
      "**/playwright.config.ts"
    ],
    "light": [
      "specs/modules/**",
      "**/src/testing/**",
      "**/*.test.ts",
      "**/*.property.test.ts",
      "**/*.integration.test.ts"
    ]
  }
}
