{
  "apps": [
    {
      "name": "api",
      "path": "apps/api",
      "kind": "backend",
      "language": "ts",
      "services": ["postgres"]
    }
  ],
  "services": [
    {
      "name": "postgres",
      "compose": "compose.yaml",
      "env": ["DATABASE_URL"]
    }
  ],
  "locked": {
    "hard": [
      "specs/product/**",
      "packages/contracts/**",
      "tests/e2e/**",
      "AGENTS.md",
      "docs/**",
      ".agents/**",
      ".github/**",
      "factory.json",
      "packages/checks/**",
      "packages/config/**",
      "package.json",
      "pnpm-workspace.yaml",
      "turbo.json",
      "**/tsconfig.json",
      "**/eslint.config.js",
      "**/vitest*.config.ts",
      "**/stryker.config.js",
      "**/playwright.config.ts"
    ],
    "light": [
      "specs/modules/**",
      "**/*.test.ts",
      "**/*.property.test.ts",
      "**/*.integration.test.ts"
    ]
  }
}
