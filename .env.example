# Copy to .env at the repo root for local runs: the api reads it on
# `pnpm dev` and `pnpm --filter @repo/api start`. Defaults match
# compose.yaml (`pnpm services:up`), so only JWT_SECRET is required.
# Turborepo does not pass shell variables to tasks, so set them here, not
# with `export`.
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
# Required to start the api: the key that signs session tokens, at least
# 32 characters. No default; use a long random value.
JWT_SECRET=
# The web app's address, used in verification links, and the origins
# allowed to call the api (comma-separated).
WEB_URL=http://localhost:5173
WEB_ORIGINS=http://localhost:5173
# Mail goes to Mailpit locally; read it at http://localhost:8025.
# In production, point SMTP_URL at Amazon SES's SMTP endpoint.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@localhost
