{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "SMTP_URL",
    "MAILPIT_URL",
    "DOCKER_*",
    "TESTCONTAINERS_*"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "test:mutation": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
